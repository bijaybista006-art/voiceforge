# ============================================================================
# VoiceForge — environment variables
#
# Set these in Vercel → your project → Settings → Environment Variables,
# then redeploy. For local dev, copy this file to `.env.local`.
#
# There are NO backend/GPU URLs here by design — those are registered at
# runtime by the notebooks or set in the admin panel, never hardcoded.
# ============================================================================


# --- Admin login ------------------------------------------------------------
# The password you type on the sign-in screen. Change it here any time.
#
# IMPORTANT: the login gate only switches ON when BOTH of the variables below
# are set. Until then the app stays open exactly as before — so deploying can
# never lock you out of your own live site before you're ready.
ADMIN_PASSWORD=

# Signs the session cookie. Use a long random string (32+ chars).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value immediately signs out every existing session.
SESSION_SECRET=


# --- Storage ----------------------------------------------------------------
# Supabase holds everything: settings, API keys, the backend registry, job
# state, usage counters, voice clips and generated audio.
# Setup, start to finish: docs/supabase-setup.md
#
# Supabase → Project Settings → API. The URL and the anon key are public
# values; the app itself does not use the anon key (the browser never talks
# to Supabase), it is here so the setup check can prove it has no access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses row level security. Server only — never give it a
# NEXT_PUBLIC_ name, never put it in a notebook or in Modal.
SUPABASE_SERVICE_ROLE_KEY=



# --- GPU backends (used from Phase 2 onward) --------------------------------
# Shared secret the gateway sends to every GPU backend as X-Backend-Secret.
# The same value must be set in the notebook / Modal secret.
BACKEND_SECRET=

# Token a Colab/Kaggle notebook presents when registering itself, so a
# stranger can't point your app at their machine. Rotatable in the admin panel.
REGISTRATION_TOKEN=
